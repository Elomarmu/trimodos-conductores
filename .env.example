# Copia este archivo como ".env" y rellena los valores. NUNCA subas ".env" al repositorio.

# "mock" = datos de prueba simulados (no toca Odoo). "real" = Odoo de verdad.
ODOO_MODE=mock

# Si es true, se hace todo MENOS escribir en Odoo.
DRY_RUN=true

ODOO_URL=
ODOO_DB=
ODOO_USER=
# Contraseña o API key del usuario de Odoo
ODOO_PASSWORD=

# Compañías con las que se lee: 1 = STINSA, 7 = TRANSARGI S.L.U. Separadas por comas.
ODOO_COMPANY_IDS=1,7

# Clave larga y aleatoria para firmar las sesiones de la app (obligatoria en modo real).
SECRET_KEY=

# Código de acceso compartido que los conductores escriben una vez en el móvil.
# OBLIGATORIO en modo real (mínimo 8 caracteres). En modo mock, si está vacío, no se pide.
APP_ACCESS_CODE=

# Etapas de la tarea en las que se puede modificar la orden (separadas por comas). Por defecto: nuevo,en desarrollo
EDITABLE_STAGES=nuevo,en desarrollo

# Peso (kg) a partir del cual la app pide confirmar «es posible que el conjunto supere la MMA». Por defecto: 27000
PESO_AVISO_KG=27000

# Hosts extra aceptados dentro del QR (además del de ODOO_URL), separados por comas.
QR_ALLOWED_HOSTS=

# Viajes de PR (SAICA PAPER): lectura de albaranes y del listado del tren con Claude.
# Clave de la API de Anthropic (console.anthropic.com → API keys). Nunca la escribas en el chat.
ANTHROPIC_API_KEY=
# Modelo (opcional). Por defecto: claude-sonnet-5-5
PR_MODELO=
# Coste por viaje al colaborador en € (opcional, por defecto 85). El recargo por gasóleo se añade a mano en Odoo.
PR_COSTE_VIAJE=
# Dirección (webhook de n8n) a la que la app manda los avisos para sevilla@stinsa.com: pedido nuevo, punto de carga nuevo.
PR_AVISOS_WEBHOOK=
# A quién van los correos de PR (pedido nuevo, punto nuevo, tren, resumen diario). En pruebas Carmelo; luego sevilla@stinsa.com
PR_CORREO_PARA=carmelomartinez@grupotrimodos.com
# Primer día que cuenta para el registro de viajes y el stock (por defecto 2026-11-01) y último tren hecho a mano (85)
PR_DESDE=
PR_ULTIMO_TREN=
