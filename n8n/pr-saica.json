    {
      "parameters": {
        "jsCode": "// Si viene de la app: se comprueba la clave y se usa lo que manda. Si es el resumen de la mañana: se pide a la app.\nconst cfg = $('Configuración').first().json;\nconst c = $('Buscar la carpeta').first().json;   // carpeta «Automatizacion»: unidad (drive) e id\nconst base = `https://graph.microsoft.com/v1.0/drives/${c.parentReference.driveId}/items/${c.id}`;\nconst ruta = (...partes) => partes.map(encodeURIComponent).join('/');\nlet d;\nif ($('Desde la app').isExecuted) {\n  const w = $('Desde la app').first().json;\n  const clave = (w.headers || {})['x-clave'] || '';\n  if (!cfg.claveWebhook || clave !== cfg.claveWebhook) throw new Error('Aviso PR con clave incorrecta: revisa PR_AVISOS_CLAVE en Vercel y «claveWebhook» en Configuración');\n  d = w.body;\n} else {\n  try {\n    d = await this.helpers.httpRequest({ method: 'GET', url: `${cfg.app}/api/pr/resumen`, json: true,\n      headers: { 'X-Clave': cfg.claveWebhook }, timeout: 60000 });\n  } catch (e) { throw new Error(`No se ha podido pedir el resumen a la app (${cfg.app}): ${e.message}`); }\n}\n// direcciones de Graph para las fotos (carpeta del tren dentro de Automatizacion)\nif (d.carpeta) {\n  d.urlCrearCarpeta = `${base}/children`;\n  if (d.nombre) d.urlFoto = `${base}:/${ruta(d.carpeta, d.nombre)}:`;\n  if (d.viejo) d.urlFoto = `${base}:/${ruta(d.carpeta, d.viejo)}:`;\n}\nd.base = base;\nreturn [{ json: d }];\n"
      },
