      "parameters": {
        "jsCode": "// Ajustes del flujo PR SAICA (app de conductores → SharePoint y correo)\nconst carpeta = 'https://grupotrimodos.sharepoint.com/:f:/s/GestionStinsa2/IgDhXF70TVa6RIjVPMcCoeveAb5bZPmGM4Ticd0VzvhCrRo?e=YFyck7';  // «Automatizacion»\nreturn [{ json: {\n  app: 'https://trimodos-conductores-pcsur-elo.vercel.app',   // dirección de la app (Vercel)\n  codigoAcceso: '<<PONER EN N8N: el mismo que APP_ACCESS_CODE en Vercel>>',\n  claveWebhook: '<<PONER EN N8N: la misma que PR_AVISOS_CLAVE en Vercel>>',\n  buzonEnvio: 'agente.trafico@transargi.com',            // buzón de la credencial «Outlook Agente Trafico»\n  paraPorDefecto: 'carmelomartinez@grupotrimodos.com',   // pruebas; luego sevilla@stinsa.com\n  carpetaGraph: 'u!' + Buffer.from(carpeta).toString('base64').replace(/=+$/, '').replace(/\\//g, '_').replace(/\\+/g, '-'),\n}}];\n"
      },
